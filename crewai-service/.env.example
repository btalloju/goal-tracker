# CrewAI Microservice Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Required Configuration
# =============================================================================

# Google AI (Gemini) - Required for all crews
# Get from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Optional Configuration - Tool APIs
# =============================================================================

# Search API (SerpAPI) - For Research Crew
# Get from: https://serpapi.com/
SERPAPI_KEY=

# Gmail API - For Communication Crew
# Get from: Google Cloud Console
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Google Docs API - For Writer Crew
GOOGLE_DOCS_API_KEY=

# Google Sheets API - For Data Crew
GOOGLE_SHEETS_API_KEY=

# =============================================================================
# Next.js App Integration
# =============================================================================

# URL of the Next.js app (for callbacks)
NEXTJS_APP_URL=http://localhost:3000

# Shared secret for callback authentication
NEXTJS_CALLBACK_SECRET=

# API key for authenticating requests from Next.js
API_KEY=

# =============================================================================
# Server Configuration
# =============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# =============================================================================
# CrewAI Configuration
# =============================================================================

# LLM settings
DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash
DEFAULT_LLM_TEMPERATURE=0.7

# Execution settings
CREWAI_VERBOSE=true
CREWAI_MAX_ITERATIONS=15
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_TIMEOUT_SECONDS=300
